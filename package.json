{
  "name": "studio-game-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build:games && vite --host 127.0.0.1",
    "dev:orbit": "vite games/orbit-break --host 127.0.0.1",
    "check": "tsc --noEmit && npm run check:games",
    "check:games": "node scripts/check-games.mjs",
    "test:orbit": "node --experimental-transform-types --test tests/orbit-v2.test.mjs",
    "test:orbit-ads": "node --experimental-transform-types --test tests/orbit-ads.test.mjs",
    "test:portal": "node --test tests/portal.test.mjs",
    "test:ads": "node --experimental-transform-types --test tests/ads.test.mjs",
    "test:reactor": "node --experimental-transform-types --test games/reactor-stack/tests/game.test.ts",
    "test:reactor-ads": "node --experimental-transform-types --test tests/reactor-ads.test.mjs",
    "build:games": "node scripts/build-games.mjs",
    "build": "npm run build:games && tsc --noEmit && vite build && node scripts/pages-routes.mjs && node scripts/verify-ads-production.mjs",
    "verify:ads-production": "node scripts/verify-ads-production.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
